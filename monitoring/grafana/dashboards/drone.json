{
  "uid": "drone-health",
  "title": "Drone health",
  "tags": ["drone", "see_me_flying"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": { "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_info == 1", "legendFormat": "{{backend}}", "instant": true, "range": false }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Armed",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_armed", "instant": true, "range": false }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DISARMED", "color": "green", "index": 0 },
                "1": { "text": "ARMED", "color": "red", "index": 1 }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active source",
      "description": "Who commands the drone (safety_manager). 'none' while armed means fc_bridge is sending zero.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_active_source == 1", "legendFormat": "{{source}}", "instant": true, "range": false }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Battery",
      "description": "4S: red below 14.0 V (3.5 V/cell), yellow below 14.8 V. No data until something publishes fc/battery (the inav backend will).",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_battery_volts", "instant": true, "range": false }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 2,
          "noValue": "NO DATA",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 14.0 },
              { "color": "green", "value": 14.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hold",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_holding", "instant": true, "range": false }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "off", "color": "green", "index": 0 },
                "1": { "text": "HOLD", "color": "orange", "index": 1 }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "FC link",
      "description": "inav: the FC answered in the last poll cycle. Always OK in the sim.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_link_ok", "instant": true, "range": false }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "LOST", "color": "red", "index": 0 },
                "1": { "text": "OK", "color": "green", "index": 1 }
              }
            }
          ],
          "noValue": "NO DATA"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rangefinder (height)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_range_meters", "legendFormat": "fc/range" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "lengthm",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Topic rates",
      "description": "Messages per second, wall clock. fc/status is 1 Hz plus changes; sensors 50 Hz in the sim; fc/setpoint_velocity 20 Hz while a source commands.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(drone_topic_messages_total[5s])", "legendFormat": "{{topic}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Time since last message",
      "description": "Age of the newest message at each scrape (wall clock). Red line at 0.5 s: above it a topic is stale, except fc/status, which is 1 Hz (up to 1 s is normal). fc/setpoint_velocity is silent while no source commands. Capped at 5 s so one silent topic does not flatten the others.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "clamp(timestamp(drone_topic_last_seen_timestamp) - drone_topic_last_seen_timestamp, 0, 5)", "legendFormat": "{{topic}}" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 0, "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "FC state age and setpoint age",
      "description": "state_age: since the last reply from the FC (0 in the sim). setpoint_age: since the last accepted setpoint; above 0.3 s fc_bridge sends zero (hover).",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "drone_state_age_seconds", "legendFormat": "FC state age" },
        { "refId": "B", "expr": "drone_setpoint_age_seconds", "legendFormat": "setpoint age" }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.3 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 0, "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      }
    }
  ]
}