<?xml version="1.0"?>
<!-- sim.launch.py camera:=fpv. The whole window shows the drone's front camera
     (sensor fpv_camera in room_world.sdf and outdoor_field.sdf, topic /fpv/image). -->
<window>
  <width>1000</width>
  <height>780</height>
</window>

<plugin filename="ImageDisplay" name="FPV">
  <gz-gui>
    <property type="bool" key="showTitleBar">false</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <topic>/fpv/image</topic>
  <topic_picker>false</topic_picker>
</plugin>
