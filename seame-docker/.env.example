# Copy to .env (or run ./make-env.sh). Do NOT commit .env.
#
# Your user and group ID on the host: run `id -u` and `id -g`.
# The container's user is created with these numbers so files it writes
# into ros2_ws/ (build/, install/, log/) are owned by you, not root.
# Changing them requires: docker compose build && docker compose up -d
HOST_UID=1000
HOST_GID=1000

# ROS 2 discovery domain, 0-101. Same number for everyone on your team,
# different from every other team in the lab.
# Changing it requires: docker compose up -d
ROS_DOMAIN_ID=42
